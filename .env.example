PORT=3000

# ── Meta Conversions API ──────────────────────────────────────────────────────

# Your Meta Pixel / Dataset ID (visible in Events Manager → Settings)
META_PIXEL_ID=

# Long-lived System User access token from Meta Business Suite
# Business Settings → System Users → Generate token with ads_management + ads_read
META_CAPI_ACCESS_TOKEN=

# Graph API version — keep on a stable release (check Meta changelog before bumping)
META_GRAPH_API_VERSION=v21.0

# Test Event Code from Events Manager → Test Events tab.
# REMOVE or leave empty in production — events sent with a test code are
# NOT counted as real conversions in your ad account.
META_TEST_EVENT_CODE=

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of frontend origins allowed to POST /api/meta/events.
# Add your deployed frontend URL here (e.g. https://aashu623.github.io).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://127.0.0.1:8080,https://aashu623.github.io

# ── Runtime ──────────────────────────────────────────────────────────────────

# Set to "production" on your hosting platform (Railway, Render, Heroku …)
NODE_ENV=development
